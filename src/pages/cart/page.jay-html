<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Cart | Onsko</title>
  <meta name="description" content="Review your cart and checkout at Onsko.">
  <script type="application/jay-headless" plugin="@jay-framework/wix-cart" contract="cart-page"
    key="cartPage"></script>
  <script type="application/jay-headless" src="../../components/site-header/site-header"
    contract="../../components/site-header/site-header.jay-contract"
    template="../../components/site-header/site-header.jay-html"></script>
  <script type="application/jay-headless" plugin="@jay-framework/wix-cart"
    contract="cart-indicator"></script>
  <script type="application/jay-headless" plugin="@jay-framework/wix-members"
    contract="login-indicator"></script>
  <script type="application/jay-headless" src="../../components/site-footer/site-footer"
    contract="../../components/site-footer/site-footer.jay-contract"
    template="../../components/site-footer/site-footer.jay-html"></script>
  <script type="application/jay-data">
      data:
    </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,200;0,400;0,600;0,700;1,400;1,700&display=swap">
  <link rel="stylesheet" href="../../styles/onsko-theme.css">
  <style>
    /* ===================================================== ONSKO CART PAGE - CENTERED COLUMN + FLOATING SUMMARY ===================================================== */
    .cart-page {
      /* fill the viewport via the flex-column body, not 100vh */
      flex: 1;
    }

    /* Cart Header Section */
    .cart-hero {
      text-align: center;
      padding: 120px var(--page-padding) 36px;
      /* design-system: allow */
      border-bottom: 1px solid var(--border);
      background: var(--bg-secondary);
    }

    .cart-hero .page-title {
      margin-bottom: 8px;
    }

    .cart-hero .item-count {
      font-size: 16px;
      color: var(--text-secondary);
    }

    .cart-hero-actions {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-top: 20px;
    }

    /* Cart Content Area */
    .cart-content-area {
      max-width: 700px;
      margin: 0 auto;
      padding: 40px var(--page-padding);
    }

    /* Cart Items List */
    .cart-items {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .cart-item {
      display: grid;
      grid-template-columns: 100px 1fr;
      gap: 20px;
      padding: 20px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      transition: all var(--transition-base);
    }

    .cart-item:hover {
      box-shadow: var(--shadow-md);
      border-color: var(--border-hover);
    }

    .cart-item.removing {
      opacity: 0.4;
      pointer-events: none;
      transform: scale(0.98);
    }

    .cart-item.updating {
      opacity: 0.7;
    }

    .cart-item-image-link {
      display: block;
    }

    .cart-item-image {
      width: 100px;
      height: 120px;
      object-fit: cover;
      border-radius: var(--radius-md);
      background: var(--bg-product-image);
    }

    .cart-item-info {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .cart-item-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
    }

    .cart-item-name {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
      line-height: 1.3;
      transition: color var(--transition-fast);
    }

    .cart-item-name:hover {
      color: var(--accent);
    }

    .cart-item-price {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
      white-space: nowrap;
    }

    .cart-item-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .cart-item-variant {
      font-size: 12px;
      color: var(--text-secondary);
      background: var(--bg-secondary);
      padding: 2px 8px;
      border-radius: var(--radius-sm);
    }

    .cart-item-sku {
      font-size: 11px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .cart-item-discount {
      font-size: 12px;
      color: var(--success);
      font-weight: 600;
    }

    .cart-item-actions-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: auto;
      padding-top: 8px;
    }

    /* Cart Summary Bar */
    .floating-summary {
      position: static;
      z-index: auto;
      box-shadow: none;
      background: var(--bg-card);
      border-top: 1px solid var(--border);
    }

    .summary-bar-inner {
      max-width: 700px;
      margin: 0 auto;
      padding: 20px var(--page-padding);
    }

    .summary-main-row {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .summary-totals {
      flex: 1;
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
    }

    .summary-item {
      display: flex;
      flex-direction: column;
    }

    .summary-item .label {
      font-size: 11px;
      margin-bottom: 2px;
    }

    .summary-item .value {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .summary-item.total .value {
      font-size: clamp(16px, 1.72vw, 22px);
      font-weight: 600;
      color: var(--accent);
    }

    .summary-item.discount .value {
      color: var(--success);
    }

    .summary-checkout {
      flex-shrink: 0;
    }

    .summary-checkout .btn {
      min-width: 160px;
    }

    /* Coupon Row */
    .coupon-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid var(--border);
    }

    .coupon-row .input {
      flex: 1;
      max-width: 180px;
      padding: 8px 12px;
      font-size: 13px;
    }

    .coupon-applied-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 12px;
      background: var(--success-bg);
      border-radius: var(--radius-md);
      font-size: 13px;
      color: var(--success);
      font-weight: 600;
    }

    .coupon-remove {
      background: none;
      border: none;
      color: var(--success);
      cursor: pointer;
      font-size: 16px;
      opacity: 0.7;
      transition: opacity var(--transition-fast);
    }

    .coupon-remove:hover {
      opacity: 1;
    }

    .coupon-error-text {
      font-size: 12px;
      color: var(--error);
    }

    /* Empty Cart */
    .empty-cart-view {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      /* centered empty state — absolute min-height, not 60vh */
      min-height: 480px;
      text-align: center;
      padding: 48px var(--page-padding);
    }

    .empty-icon {
      font-size: 80px;
      /* design-system: allow */
      margin-bottom: 24px;
      opacity: 0.15;
    }

    .empty-title {
      font-size: clamp(20px, 2.19vw, 28px);
      font-weight: 600;
      margin-bottom: 12px;
      color: var(--text-primary);
    }

    /* Loading State */
    .cart-loading-view {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      /* centered loading state — absolute min-height, not 50vh */
      min-height: 400px;
      gap: 20px;
    }

    .loading-spinner-large {
      width: 48px;
      height: 48px;
      border: 3px solid var(--border);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: cart-spin 0.7s linear infinite;
    }

    @keyframes cart-spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* Responsive */
    @media (max-width: 768px) {
      .cart-item {
        grid-template-columns: 80px 1fr;
        gap: 12px;
        padding: 16px;
      }

      .cart-item-image {
        width: 80px;
        height: 100px;
      }

      .cart-item-header {
        flex-direction: column;
        gap: 4px;
      }

      .summary-main-row {
        flex-direction: column;
        gap: 16px;
      }

      .summary-totals {
        width: 100%;
        justify-content: space-between;
      }

      .summary-checkout {
        width: 100%;
      }

      .summary-checkout .btn {
        width: 100%;
      }

      .coupon-row {
        flex-wrap: wrap;
      }

      .coupon-row .input {
        max-width: none;
        flex: 1 1 auto;
      }
    }

    @media (max-width: 600px) {
      .cart-hero-actions {
        flex-direction: column;
      }

      .cart-hero-actions .btn {
        width: 100%;
      }
    }

    @scope (.siteHeader) {
      @keyframes site-header-float-in {
        0% {
          opacity: 0;
          transform: translateY(-30px);
        }

        100% {
          opacity: 1;
          transform: translateY(0);
        }
      }

      :scope {
        display: contents;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        padding: 50px 50px 0;
        margin-bottom: -97px;
        /* design-system: allow */
        animation: site-header-float-in 0.7s ease-out backwards;
        background: rgba(238, 238, 238, 0);
        /* design-system: allow */
        transition: transform 0.5s ease, opacity 0.5s ease;
      }

      .site-header.header-hidden {
        transform: translateY(-110%);
        opacity: 0;
        transition: transform 0.5s ease 0.2s, opacity 0.5s ease 0.5s;
      }

      .site-header-bar {
        background: rgb(174, 58, 0);
        border-radius: var(--radius-full);
        box-shadow: var(--shadow-md);
        height: 47px;
      }

      .site-header-inner {
        margin: 0 auto;
        display: flex;
        align-items: center;
        height: 100%;
        padding: 0 24px;
        gap: 24px;
      }

      .site-logo {
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-primary);
        font-size: clamp(24px, 2.5vw, 32px);
        font-weight: 600;
        color: #ffffff;
        letter-spacing: -0.96px;
        white-space: nowrap;
      }

      .site-logo-icon {
        display: flex;
        align-items: center;
        color: #ffffff;
      }

      .site-logo-icon svg {
        width: 24px;
        height: 24px;
      }

      .site-nav {
        display: flex;
        align-items: center;
        gap: 24px;
      }

      .site-nav a {
        font-family: var(--font-primary);
        font-size: 16px;
        font-weight: 500;
        color: #ffffff;
        padding: 4px 0;
        transition: color var(--transition-fast);
      }

      .site-nav a:hover {
        color: rgba(255, 255, 255, 0.75);
      }

      .site-header-actions {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-left: auto;
        color: #ffffff;
      }

      .site-header-action-text {
        font-family: var(--font-primary);
        font-size: 16px;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.9);
        transition: color var(--transition-fast);
        white-space: nowrap;
      }

      .site-header-action-text:hover {
        color: #ffffff;
      }

      .site-login-btn {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
      }

      .site-cart-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
      }

      .site-cart-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 24px;
        height: 24px;
        padding: 0 6px;
        background: #ffffff;
        color: #1a1a1a;
        font-family: var(--font-primary);
        font-size: 12px;
        font-weight: 600;
        border-radius: var(--radius-full);
      }

      .site-cart-indicator.just-added {
        animation: cart-flash 0.4s ease;
      }

      @keyframes cart-flash {

        0%,
        100% {
          transform: scale(1);
        }

        50% {
          transform: scale(1.15);
        }
      }

      /* ── Hamburger Button ── */
      .site-hamburger-btn {
        display: none;
        align-items: center;
        justify-content: center;
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        color: #ffffff;
      }

      .site-hamburger-btn svg {
        width: 24px;
        height: 24px;
      }

      /* ── Mobile Menu (Popover) ── */
      .site-mobile-menu {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        max-width: 100%;
        max-height: 100%;
        margin: 0;
        padding: 0;
        border: none;
        background: #f5f3ef;
        z-index: 200;
        opacity: 0;
        transform: translateX(100%);
        transition: opacity 0.3s ease, transform 0.3s ease, display 0.3s ease allow-discrete;
      }

      .site-mobile-menu:popover-open {
        opacity: 1;
        transform: translateX(0);
      }

      @starting-style {
        .site-mobile-menu:popover-open {
          opacity: 0;
          transform: translateX(100%);
        }
      }

      .site-mobile-menu-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 24px 32px;
      }

      .site-mobile-menu-logo {
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: 'Poppins', 'Poppins Fallback', sans-serif;
        font-size: 28px;
        font-weight: 600;
        color: #2D5143;
        letter-spacing: -0.96px;
      }

      .site-mobile-menu-logo svg {
        width: 20px;
        height: 20px;
        color: #2D5143;
      }

      .site-mobile-menu-close {
        display: flex;
        align-items: center;
        justify-content: center;
        background: none;
        border: none;
        padding: 8px;
        cursor: pointer;
        color: #2D5143;
      }

      .site-mobile-menu-close svg {
        width: 24px;
        height: 24px;
      }

      .site-mobile-menu-nav {
        display: flex;
        flex-direction: column;
        padding: 40px 32px;
        gap: 12px;
      }

      .site-mobile-menu-nav a {
        font-family: 'Poppins', 'Poppins Fallback', sans-serif;
        font-size: 22px;
        font-weight: 600;
        color: #2D5143;
        padding: 8px 0;
      }

      .site-mobile-menu-nav a.active {
        color: #AE3A00;
      }

      .site-mobile-menu-login {
        display: none;
        padding: 0 32px;
      }

      .site-mobile-menu-login button,
      .site-mobile-menu-login span {
        font-family: 'Poppins', 'Poppins Fallback', sans-serif;
        font-size: 22px;
        font-weight: 600;
        color: #2D5143;
        background: none;
        border: none;
        padding: 8px 0;
        cursor: pointer;
      }

      @media (max-width: 1024px) {
        .site-nav {
          display: none;
        }

        .site-hamburger-btn {
          display: flex;
        }

        .site-header {
          padding: 50px 25px 0;
        }
      }
    }

    @scope (.siteFooter) {
      :scope {
        background: var(--bg-footer);
        color: var(--text-inverse);
        padding: 64px var(--page-padding) 32px;
      }

      .footer-inner {
        max-width: var(--container-max);
        margin: 0 auto;
      }

      .footer-columns {
        display: grid;
        grid-template-columns: auto auto auto 1fr;
        gap: 48px;
        margin-bottom: 64px;
      }

      .footer-col h3 {
        font-family: var(--font-primary);
        font-size: clamp(16px, 1.56vw, 20px);
        font-weight: 600;
        margin-bottom: 20px;
        letter-spacing: 0.02em;
      }

      .footer-col a {
        display: block;
        font-family: var(--font-primary);
        font-size: 14px;
        opacity: 0.7;
        margin-bottom: 10px;
        transition: opacity var(--transition-fast);
      }

      .footer-col a:hover {
        opacity: 1;
      }

      .footer-col p {
        font-family: var(--font-caption);
        font-size: 13px;
        opacity: 0.7;
        margin-bottom: 6px;
      }

      .footer-newsletter .input {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: var(--text-inverse);
        border-radius: var(--radius-md);
        width: 100%;
        margin-bottom: 12px;
        padding: 10px 12px;
        font-size: 14px;
      }

      .footer-newsletter .input::placeholder {
        color: rgba(255, 255, 255, 0.5);
      }

      .footer-newsletter .input:focus {
        outline: none;
        border-color: var(--cta);
      }

      .footer-newsletter label {
        display: block;
        font-size: 12px;
        opacity: 0.7;
        margin-bottom: 8px;
      }

      .footer-newsletter .newsletter-checkbox {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 12px;
        opacity: 0.7;
        margin-bottom: 16px;
        cursor: pointer;
      }

      .footer-newsletter .newsletter-checkbox input {
        margin-top: 2px;
        accent-color: var(--cta);
      }

      .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        padding-top: 32px;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
      }

      .footer-logo {
        font-family: var(--font-primary);
        font-size: clamp(32px, 3.75vw, 48px);
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .footer-logo .logo-icon-large {
        color: var(--accent);
      }

      .footer-meta {
        text-align: right;
      }

      .footer-meta p {
        font-family: var(--font-caption);
        font-size: 12px;
        opacity: 0.6;
        margin-bottom: 12px;
      }

      .social-icons {
        display: flex;
        gap: 16px;
        justify-content: flex-end;
      }

      .social-icons a {
        font-size: 18px;
        opacity: 0.7;
      }

      .social-icons a:hover {
        opacity: 1;
      }

      @media (max-width: 1024px) {
        .footer-columns {
          grid-template-columns: 1fr 1fr;
          gap: 32px;
        }
      }

      @media (max-width: 600px) {
        .footer-columns {
          grid-template-columns: 1fr;
          gap: 24px;
        }

        .footer-bottom {
          flex-direction: column;
          align-items: flex-start;
          gap: 24px;
        }

        .footer-meta {
          text-align: left;
        }

        .social-icons {
          justify-content: flex-start;
        }
      }
    }
  </style>
</head>

<body>
  <main class="cart-page"><jay:site-header ref="siteHeader">
      <div class="site-header-root siteHeader">
        <header class="site-header {headerHidden ? header-hidden}">
          <div class="site-header-bar">
            <div class="site-header-inner"><a href="/" class="site-logo"><span
                  class="site-logo-icon"><svg preserveAspectRatio="xMidYMid meet"
                    xmlns="http://www.w3.org/2000/svg" viewBox="0 0 19.009 19" height="19"
                    width="19" role="presentation" aria-hidden="true">
                    <path fill="currentColor"
                      d="M16.392 9.5A2.626 2.626 0 0 0 19 6.875a2.63 2.63 0 0 0-2.624-2.626c-.723 0-1.412.149-2.04.413a5.2 5.2 0 0 0 .413-2.04A2.62 2.62 0 0 0 12.124.003 2.62 2.62 0 0 0 9.5 2.607 2.626 2.626 0 0 0 6.876 0 2.63 2.63 0 0 0 4.25 2.625c0 .723.147 1.413.413 2.04a5.25 5.25 0 0 0-2.04-.413A2.623 2.623 0 0 0 .002 6.877a2.62 2.62 0 0 0 2.606 2.624A2.626 2.626 0 0 0 0 12.126a2.627 2.627 0 0 0 2.624 2.624 5.2 5.2 0 0 0 2.04-.413 5.2 5.2 0 0 0-.413 2.04 2.62 2.62 0 0 0 2.625 2.621A2.62 2.62 0 0 0 9.5 16.393 2.626 2.626 0 0 0 12.124 19a2.63 2.63 0 0 0 2.625-2.625c0-.723-.147-1.412-.413-2.04a5.2 5.2 0 0 0 2.04.413 2.624 2.624 0 0 0 .016-5.249m-6.895 1.626c-.723 0-1.414.148-2.04.413a5.2 5.2 0 0 0 .413-2.04 5.2 5.2 0 0 0-.413-2.04 5.2 5.2 0 0 0 2.04.413 5.2 5.2 0 0 0 2.04-.412 5.2 5.2 0 0 0-.413 2.04c0 .722.147 1.412.413 2.039a5.25 5.25 0 0 0-2.04-.413">
                    </path>
                  </svg></span> onsko</a>
              <nav class="site-nav"><a href="/">home</a><a href="/products">shop</a><a
                  href="/#our-story">about</a></nav>
              <div class="site-header-actions"><jay:login-indicator><button if="!isLoggedIn"
                    ref="loginButton" class="site-header-action-text site-login-btn">log
                    in</button><span if="isLoggedIn"
                    class="site-header-action-text">{memberName}</span><button if="isLoggedIn"
                    ref="logoutButton" class="site-header-action-text site-login-btn">log
                    out</button></jay:login-indicator><jay:cart-indicator><a href="/cart"
                    class="site-cart-indicator {hasItems ? has-items} {isLoading ? is-loading} {justAdded ? just-added}"
                    ref="cartLink"><span
                      class="site-cart-badge">{itemCount}</span></a></jay:cart-indicator><button
                  class="site-hamburger-btn" popovertarget="site-mobile-menu"
                  aria-label="Open menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                  </svg></button></div>
            </div>
          </div>
        </header>
        <div id="site-mobile-menu" popover class="site-mobile-menu">
          <div class="site-mobile-menu-header"><a href="/" class="site-mobile-menu-logo"><svg
                preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 19.009 19" height="19" width="19" role="presentation"
                aria-hidden="true">
                <path fill="currentColor"
                  d="M16.392 9.5A2.626 2.626 0 0 0 19 6.875a2.63 2.63 0 0 0-2.624-2.626c-.723 0-1.412.149-2.04.413a5.2 5.2 0 0 0 .413-2.04A2.62 2.62 0 0 0 12.124.003 2.62 2.62 0 0 0 9.5 2.607 2.626 2.626 0 0 0 6.876 0 2.63 2.63 0 0 0 4.25 2.625c0 .723.147 1.413.413 2.04a5.25 5.25 0 0 0-2.04-.413A2.623 2.623 0 0 0 .002 6.877a2.62 2.62 0 0 0 2.606 2.624A2.626 2.626 0 0 0 0 12.126a2.627 2.627 0 0 0 2.624 2.624 5.2 5.2 0 0 0 2.04-.413 5.2 5.2 0 0 0-.413 2.04 2.62 2.62 0 0 0 2.625 2.621A2.62 2.62 0 0 0 9.5 16.393 2.626 2.626 0 0 0 12.124 19a2.63 2.63 0 0 0 2.625-2.625c0-.723-.147-1.412-.413-2.04a5.2 5.2 0 0 0 2.04.413 2.624 2.624 0 0 0 .016-5.249m-6.895 1.626c-.723 0-1.414.148-2.04.413a5.2 5.2 0 0 0 .413-2.04 5.2 5.2 0 0 0-.413-2.04 5.2 5.2 0 0 0 2.04.413 5.2 5.2 0 0 0 2.04-.412 5.2 5.2 0 0 0-.413 2.04c0 .722.147 1.412.413 2.039a5.25 5.25 0 0 0-2.04-.413">
                </path>
              </svg> onsko</a><button popovertarget="site-mobile-menu" popovertargetaction="hide"
              class="site-mobile-menu-close" aria-label="Close menu"><svg viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="6" y1="6" x2="18" y2="18"></line>
                <line x1="6" y1="18" x2="18" y2="6"></line>
              </svg></button></div>
          <nav class="site-mobile-menu-nav"><a href="/">home</a><a href="/products">shop</a><a
              href="/#our-story">about</a></nav>
          <div class="site-mobile-menu-login"><jay:login-indicator><button if="!isLoggedIn"
                ref="loginButton" class="site-mobile-login-btn" popovertarget="site-mobile-menu"
                popovertargetaction="hide">log in</button><span
                if="isLoggedIn">{memberName}</span><button if="isLoggedIn" ref="logoutButton"
                class="site-mobile-login-btn" popovertarget="site-mobile-menu"
                popovertargetaction="hide">log out</button></jay:login-indicator></div>
        </div>
      </div>
    </jay:site-header>
    <section class="cart-hero">
      <h1 class="page-title">your cart</h1>
      <p class="item-count" if="cartPage.summary.itemCount >= 0">{cartPage.summary.itemCount} items
      </p>
      <div class="cart-hero-actions"><a href="/products" ref="cartPage.continueShoppingLink"
          class="btn btn-ghost">continue shopping</a><button ref="cartPage.clearCartButton"
          class="btn btn-ghost">clear cart</button></div>
    </section>
    <div class="cart-loading-view" if="cartPage.isLoading">
      <div class="loading-spinner-large"></div>
      <p style="color: var(--text-secondary);">loading your cart...</p>
    </div>
    <div class="empty-cart-view" if="cartPage.isEmpty && !cartPage.isLoading">
      <div class="empty-icon">🛒</div>
      <h2 class="empty-title">your cart is empty</h2><a href="/products"
        ref="cartPage.emptyCartLink" class="btn btn-primary btn-lg">start shopping</a>
    </div>
    <div class="cart-content-area" if="!cartPage.isEmpty && !cartPage.isLoading">
      <div class="cart-items">
        <article class="cart-item {isUpdatingQuantity ? updating} {isRemoving ? removing}"
          forEach="cartPage.lineItems" trackBy="lineItemId"><a href="{productUrl}"
            class="cart-item-image-link"><img class="cart-item-image"
              src="{image.url}/v1/fill/w_200,h_240/file.webp" alt="{image.altText}" loading="lazy"
              width="200" height="240" fetchpriority="high"></a>
          <div class="cart-item-info">
            <div class="cart-item-header"><a href="{productUrl}" class="cart-item-name"
                ref="cartPage.lineItems.productLink">{productName}</a><span
                class="cart-item-price">{lineTotal.formattedAmount}</span></div>
            <div class="cart-item-meta"><span class="cart-item-variant"
                if="variantName">{variantName}</span><span class="cart-item-sku" if="sku">SKU:
                {sku}</span></div><span class="cart-item-discount" if="hasDiscount">Save
              {lineDiscount.formattedAmount}</span>
            <div class="cart-item-actions-row">
              <div class="qty-controls"><button class="qty-btn"
                  ref="cartPage.lineItems.decrementButton">&minus;</button><input type="number"
                  class="qty-input" ref="cartPage.lineItems.quantity" value="{quantity}" min="1"
                  max="99" aria-label="Quantity"><button class="qty-btn"
                  ref="cartPage.lineItems.incrementButton">+</button></div><button
                class="remove-btn" ref="cartPage.lineItems.removeButton">remove</button>
            </div>
          </div>
        </article>
      </div>
    </div>
    <div class="floating-summary" if="!cartPage.isEmpty && !cartPage.isLoading">
      <div class="summary-bar-inner">
        <div class="summary-main-row">
          <div class="summary-totals">
            <div class="summary-item"><span class="label">subtotal</span><span
                class="value">{cartPage.summary.subtotal.formattedAmount}</span></div>
            <div class="summary-item discount" if="cartPage.summary.hasDiscount"><span
                class="label">discount</span><span
                class="value">-{cartPage.summary.discount.formattedAmount}</span></div>
            <div class="summary-item" if="cartPage.summary.showTax"><span class="label">est.
                tax</span><span class="value">{cartPage.summary.estimatedTax.formattedAmount}</span>
            </div>
            <div class="summary-item total"><span class="label">total</span><span
                class="value">{cartPage.summary.estimatedTotal.formattedAmount}</span></div>
          </div>
          <div class="summary-checkout"><button class="btn btn-primary btn-lg"
              ref="cartPage.checkoutButton"><span if="!cartPage.isCheckingOut">checkout</span><span
                if="cartPage.isCheckingOut">processing...</span></button></div>
        </div>
        <div class="coupon-row">
          <div if="!cartPage.coupon.hasAppliedCoupon"
            style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;"><input
              type="text" class="input" ref="cartPage.coupon.code" value="{cartPage.coupon.code}"
              placeholder="promo code" aria-label="Promo code"><button class="btn btn-ghost btn-sm"
              ref="cartPage.coupon.applyButton">apply</button><span class="coupon-error-text"
              if="cartPage.coupon.hasError">{cartPage.coupon.errorMessage}</span></div>
          <div class="coupon-applied-tag" if="cartPage.coupon.hasAppliedCoupon" jay-design="allow">✓
            {cartPage.coupon.appliedCode}<button class="coupon-remove"
              ref="cartPage.coupon.removeButton">×</button></div>
        </div>
      </div>
    </div><jay:site-footer ref="siteFooter">
      <footer class="site-footer siteFooter">
        <div class="footer-inner">
          <div class="footer-columns">
            <div class="footer-col">
              <h3>shop</h3><a href="/">home</a><a href="/products">shop</a>
            </div>
            <div class="footer-col">
              <h3>policy</h3><a href="/terms-and-conditions">terms & conditions</a><a
                href="/privacy-policy">privacy policy</a><a href="/refund-policy">refund
                policy</a><a href="/shipping-policy">shipping policy</a><a
                href="/accessibility">accessibility statement</a>
            </div>
            <div class="footer-col">
              <h3>contact</h3>
              <p>500 terry francine street</p>
              <p>san francisco, ca 94158</p>
              <p>info@mysite.com</p>
              <p>123-456-7890</p>
            </div>
            <div class="footer-col footer-newsletter">
              <h3>subscribe to our newsletter</h3>
              <p>be the first to know about our hottest discounts</p><label for="footer-email">Email
                *</label><input type="email" id="footer-email" class="input"
                placeholder="your email" aria-label="Email for newsletter"><label
                class="newsletter-checkbox"><input type="checkbox"> Yes, subscribe me to your
                newsletter. *</label><button class="btn btn-cta">subscribe</button>
            </div>
          </div>
          <div class="footer-bottom">
            <div class="footer-logo"><span class="logo-icon-large">✻</span> onsko</div>
            <div class="footer-meta">
              <p>&copy; 2035 by onsko</p>
              <div class="social-icons"><a href="#" aria-label="Instagram">IG</a><a href="#"
                  aria-label="Facebook">FB</a><a href="#" aria-label="TikTok">TT</a></div>
            </div>
          </div>
        </div>
      </footer>
    </jay:site-footer>
  </main>
</body>

</html>