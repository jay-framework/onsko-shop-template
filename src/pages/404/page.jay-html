<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script type="application/jay-headless" plugin="jay-stack" contract="error" key="error"></script>
  <script type="application/jay-data">
data:
  </script>
  <title>{error.title} — onsko</title>
  <meta name="description" content="{error.message}">
  <link rel="stylesheet" href="../../styles/onsko-theme.css">
  <style>
    .error-page {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 16px;
      padding: 80px var(--page-padding) 100px;
      background: var(--bg-primary);
      color: var(--text-primary);
    }

    .error-page .error-status {
      font-size: 64px;
      font-weight: 600;
      line-height: 1;
      color: var(--accent);
    }

    .error-page .error-title {
      font-size: 28px;
      font-weight: 600;
    }

    .error-page .error-message {
      max-width: 480px;
      color: var(--text-secondary);
    }

    .error-page .error-home-link {
      margin-top: 8px;
      color: var(--accent);
      font-weight: 600;
      text-decoration: underline;
    }
  </style>
</head>

<body>
  <main class="error-page">
    <p class="error-status">{error.status}</p>
    <h1 class="error-title">{error.title}</h1>
    <p class="error-message">{error.message}</p>
    <a href="/" class="error-home-link">Back to home</a>
  </main>
</body>

</html>
