<html>
  <head>
    <script type="application/jay-data" contract="./site-footer.jay-contract"></script>
  </head>
  <body>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-columns">
          <div class="footer-col">
            <h3>shop</h3>
            <a href="/">home</a>
            <a href="/products">shop</a>
          </div>
          <div class="footer-col">
            <h3>policy</h3>
            <a href="/terms-and-conditions">terms & conditions</a>
            <a href="/privacy-policy">privacy policy</a>
            <a href="/refund-policy">refund policy</a>
            <a href="/shipping-policy">shipping policy</a>
            <a href="/accessibility">accessibility statement</a>
          </div>
          <div class="footer-col">
            <h3>contact</h3>
            <p>500 terry francine street</p>
            <p>san francisco, ca 94158</p>
            <p>info@mysite.com</p>
            <p>123-456-7890</p>
          </div>
          <div class="footer-col footer-newsletter">
            <h3>subscribe to our newsletter</h3>
            <p>be the first to know about our hottest discounts</p>
            <label for="footer-email">Email *</label>
            <input type="email" id="footer-email" class="input" placeholder="your email" aria-label="Email for newsletter" />
            <label class="newsletter-checkbox">
              <input type="checkbox" /> Yes, subscribe me to your newsletter. *
            </label>
            <button class="btn btn-cta">subscribe</button>
          </div>
        </div>
        <div class="footer-bottom">
          <div class="footer-logo"><span class="logo-icon-large">✻</span> onsko</div>
          <div class="footer-meta">
            <p>&copy; 2035 by onsko</p>
            <div class="social-icons">
              <a href="#" aria-label="Instagram">IG</a>
              <a href="#" aria-label="Facebook">FB</a>
              <a href="#" aria-label="TikTok">TT</a>
            </div>
          </div>
        </div>
      </div>
    </footer>
  </body>
  <style>
    .site-footer {
      background: var(--bg-footer);
      color: var(--text-inverse);
      padding: 64px var(--page-padding) 32px;
    }

    .footer-inner {
      max-width: var(--container-max);
      margin: 0 auto;
    }

    .footer-columns {
      display: grid;
      grid-template-columns: auto auto auto 1fr;
      gap: 48px;
      margin-bottom: 64px;
    }

    .footer-col h3 {
      font-family: var(--font-primary);
      font-size: clamp(16px, 1.56vw, 20px);
      font-weight: 600;
      margin-bottom: 20px;
      letter-spacing: 0.02em;
    }

    .footer-col a {
      display: block;
      font-family: var(--font-primary);
      font-size: 14px;
      opacity: 0.7;
      margin-bottom: 10px;
      transition: opacity var(--transition-fast);
    }

    .footer-col a:hover { opacity: 1; }

    .footer-col p {
      font-family: var(--font-caption);
      font-size: 13px;
      opacity: 0.7;
      margin-bottom: 6px;
    }

    .footer-newsletter .input {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: var(--text-inverse);
      border-radius: var(--radius-md);
      width: 100%;
      margin-bottom: 12px;
      padding: 10px 12px;
      font-size: 14px;
    }

    .footer-newsletter .input::placeholder { color: rgba(255, 255, 255, 0.5); }

    .footer-newsletter .input:focus {
      outline: none;
      border-color: var(--cta);
    }

    .footer-newsletter label {
      display: block;
      font-size: 12px;
      opacity: 0.7;
      margin-bottom: 8px;
    }

    .footer-newsletter .newsletter-checkbox {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font-size: 12px;
      opacity: 0.7;
      margin-bottom: 16px;
      cursor: pointer;
    }

    .footer-newsletter .newsletter-checkbox input {
      margin-top: 2px;
      accent-color: var(--cta);
    }

    .footer-bottom {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding-top: 32px;
      border-top: 1px solid rgba(255, 255, 255, 0.15);
    }

    .footer-logo {
      font-family: var(--font-primary);
      font-size: clamp(32px, 3.75vw, 48px);
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .footer-logo .logo-icon-large {
      color: var(--accent);
    }

    .footer-meta {
      text-align: right;
    }

    .footer-meta p {
      font-family: var(--font-caption);
      font-size: 12px;
      opacity: 0.6;
      margin-bottom: 12px;
    }

    .social-icons {
      display: flex;
      gap: 16px;
      justify-content: flex-end;
    }

    .social-icons a {
      font-size: 18px;
      opacity: 0.7;
    }

    .social-icons a:hover { opacity: 1; }

    @media (max-width: 1024px) {
      .footer-columns { grid-template-columns: 1fr 1fr; gap: 32px; }
    }

    @media (max-width: 600px) {
      .footer-columns { grid-template-columns: 1fr; gap: 24px; }
      .footer-bottom { flex-direction: column; align-items: flex-start; gap: 24px; }
      .footer-meta { text-align: left; }
      .social-icons { justify-content: flex-start; }
    }
  </style>
</html>
